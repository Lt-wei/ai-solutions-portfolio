# OpenAI API Automation Configuration

# OpenAI API Key (optional - falls back to mock mode without it)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model (optional - defaults to gpt-4o-mini)
# Options: gpt-4o-mini, gpt-4o, gpt-3.5-turbo, etc.
OPENAI_MODEL=gpt-4o-mini

# Telegram Bot Configuration (optional - uses stub logging without these)
# Create a bot: https://t.me/botfather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Email Configuration (optional)
EMAIL_ENABLED=false

# Server Configuration
HOST=0.0.0.0
PORT=8003
LOG_LEVEL=INFO
